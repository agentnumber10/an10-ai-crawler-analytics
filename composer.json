{
	"name": "agentnumber10/wp-aeo",
	"description": "WordPress plugin: verified AI crawler visits, AI referrals and answer readiness.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0.30"
		}
	},
	"scripts": {
		"generate": "php bin/generate.php",
		"check-generated": "php bin/generate.php --check",
		"test": "phpunit",
		"lint": "phpcs"
	}
}
